---
import Base from '../../../layouts/Base.astro';
import { listModules, renderModuleDoc } from '../../../lib/content.js';

export function getStaticPaths() {
  return listModules().map((m) => ({ params: { slug: m.slug }, props: m }));
}

const { slug, title, html } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const subPages = [
  ['self-guided', 'Self-guided'],
  ['workshop', 'Workshop'],
  ['mentor-guide', "Mentor's guide"],
].filter(([doc]) => renderModuleDoc(slug, doc));
---
<Base title={title}>
  <article class="prose" set:html={html} />
  {subPages.length > 0 && (
    <nav class="label" aria-label="Module paths">
      {subPages.map(([doc, label]) => (
        <a href={`${base}/modules/${slug}/${doc}/`}>{label}</a>
      ))}
    </nav>
  )}
</Base>
