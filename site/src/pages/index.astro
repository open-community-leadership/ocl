---
import Base from '../layouts/Base.astro';
import { listNewItems } from '../lib/content.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const newItems = listNewItems();
const popcom = [
  ['P', 'Participation', 'How people join'],
  ['O', 'Ownership', 'How people gain responsibility'],
  ['P', 'Purpose', 'Why people stay'],
  ['C', 'Connection', 'How relationships form'],
  ['O', 'Opportunity', 'How contributors grow'],
  ['M', 'Mentorship', 'How communities reproduce themselves'],
];
---
<Base title="Home">
  <section class="hero">
    <div class="hero-main">
      <h1>Open Community Leadership</h1>
      <h2>Helping communities create future contributors and leaders</h2>
      <p>
      Open Community Leadership (OCL) is an open-source project that turns community knowledge into practical frameworks, tools, and learning resources. Through POPCOM, it helps communities understand how people join, contribute, take responsibility, build relationships, and grow into future leaders. 
      </p>
      <div class="cta-row">
        <a class="cta solid" href={`${base}/popcom/`}>Explore the framework</a>
        <a class="cta" href={`${base}/modules/`}>Start a module</a>
      </div>
    </div>
    <div class="hero-margin" aria-hidden="true">
      <span>A framework for open community leadership</span>
    </div>
  </section>

  <section class="gives-section">
    <h2>What OCL gives you</h2>
    <div class="gives">
      <div class="gives-item">
        <h3>A framework</h3>
        <p>POPCOM gives you a shared language for community health.</p>
      </div>
      <div class="gives-item">
        <h3>A module path</h3>
        <p>Each module turns one part of community leadership into practice.</p>
      </div>
      <div class="gives-item">
        <h3>A resource library</h3>
        <p>Canvases, checklists, examples, badges, and guides you can reuse.</p>
      </div>
      <div class="gives-item">
        <h3>A way to pass it on</h3>
        <p>Take what helps, change what does not fit, and pass on what you learn.</p>
      </div>
    </div>
  </section>

  <section class="spec">
    <div class="spec-label"><span class="label">The framework:</span></div>
    <div class="spec-body">
      <h3>POPCOM is the lens running through every OCL module.</h3>
      <p>It helps community leaders see where people enter, where they get stuck, and where future leaders begin to grow.</p>
      <table class="popcom">
        <tbody>
          {popcom.map(([letter, dim, desc]) => (
            <tr>
              <td class="letter">{letter}</td>
              <td class="dim">{dim}</td>
              <td class="desc">{desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="spec">
    <div class="spec-label"><span class="label">The paths:</span></div>
    <div class="spec-body" style="padding: 0;">
      <div class="paths">
        <div class="path">
          <a href={`${base}/modules/`}>
            <h3>Self-guided</h3>
            <p>Work through the modules at your own pace.</p>
          </a>
        </div>
        <div class="path">
          <a href={`${base}/modules/`}>
            <h3>Workshop</h3>
            <p>Run a facilitated session with your team.</p>
          </a>
        </div>
        <div class="path">
          <a href={`${base}/modules/`}>
            <h3>Mentor</h3>
            <p>Support others as they grow into leadership.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="spec">
    <div class="spec-label"><span class="label">Start here:</span></div>
    <div class="spec-body">
      <h3>The Experience Is the Community</h3>
      <p>The first OCL module helps you map how people actually move through your community, from arrival to return. Use it alone, in a workshop, or as a mentor guiding others.</p>
      <a class="cta" href={`${base}/modules/01-experience-is-the-community/`}>Go to module one</a>
    </div>
  </section>

  <section class="spec">
    <div class="spec-label"><span class="label">Resources:</span></div>
    <div class="spec-body">
      <h3>Available now</h3>
      <ul>
        <li><a href={`${base}/resources/templates/module-01/OCL%C2%B7WORKSHOP-1-Community-Experience-Canvas.pdf`}>Community Experience Canvas</a></li>
        <li><a href={`${base}/resources/examples/module-01/OCL%20%C2%B7%20WORKSHOP%201%20%C2%B7%20Community-Experience-Canvas-examples.pdf`}>Canvas examples</a></li>
      </ul>
      <h3>Coming next</h3>
      <ul>
        <li>Module 1 badge</li>
        <li>Checklists</li>
        <li>Feedback forms</li>
        <li>More modules…</li>
      </ul>
    </div>
  </section>

  {newItems.length > 0 && (
    <section class="spec">
      <div class="spec-label"><span class="label">Recently added:</span></div>
      <div class="spec-body">
        <ul>
          {newItems.map((item) => (
            <li><a href={item.href}>{item.title}</a> <span class="tag-new">New</span></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>
