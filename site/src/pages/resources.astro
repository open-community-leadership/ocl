---
import Base from '../layouts/Base.astro';
import { renderDocSplit, listResourceSections } from '../lib/content.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { html, attributionHtml } = renderDocSplit('resources/README.md');
const sections = listResourceSections().filter((section) => section.slug !== 'passport');
---
<Base title="Resources">
  <article class="prose" set:html={html} />
  <div class="prose">
    {sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        {section.description && <p>{section.description}</p>}
        {section.slug === 'badges' ? (
          <ul>
            <li><a href={`${base}/badges/`}>OCL Badges — how to earn and claim</a></li>
          </ul>
        ) : section.files.length > 0 ? (
          <ul>
            {section.files.map((file) => (
              <li><a href={file.href}>{file.name}</a>{file.isNew && <span class="tag-new">New</span>}</li>
            ))}
          </ul>
        ) : (
          <p><em>No files yet.</em></p>
        )}
      </section>
    ))}
  </div>
  {attributionHtml && <div class="prose" set:html={attributionHtml} />}
</Base>
