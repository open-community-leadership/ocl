---
import Base from '../../../layouts/Base.astro';
import { listInterviews, renderInterview } from '../../../lib/content.js';

export function getStaticPaths() {
  return listInterviews().map((i) => ({ params: { slug: i.slug }, props: renderInterview(i.slug) }));
}

const { title, html } = Astro.props;
---
<Base title={title}>
  <article class="prose" set:html={html} />
</Base>
